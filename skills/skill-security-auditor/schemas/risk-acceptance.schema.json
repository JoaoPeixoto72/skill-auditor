{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-security-auditor/risk-acceptance.schema.json",
  "title": "Agent Skill Risk Acceptance Record",
  "description": "Authoritative operator record accepting specific security findings with compensating controls",
  "type": "object",
  "required": [
    "schemaVersion",
    "target",
    "acceptedRisks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "target": {
      "type": "string"
    },
    "bundleHash": {
      "type": "string",
      "pattern": "^(sha256:)?[a-f0-9]{64}$"
    },
    "acceptedRisks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "findingId",
          "scope",
          "justification",
          "controls",
          "approver",
          "timestamp",
          "expiration"
        ],
        "properties": {
          "findingId": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "justification": {
            "type": "string"
          },
          "controls": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "approver": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "expiration": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "operatorSignature": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
