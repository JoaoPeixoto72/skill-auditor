{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime/trust-registry.schema.json",
  "title": "Trust Registry Schema v2.0.0",
  "description": "Schema for privileged Trust Registry database persisting trusted skills, keys, and quarantine states",
  "type": "object",
  "required": [
    "version",
    "trustedKeys",
    "skills"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "2.0.0"
    },
    "trustedKeys": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "keyId",
          "publicKeyPem",
          "addedAt"
        ],
        "properties": {
          "keyId": {
            "type": "string"
          },
          "publicKeyPem": {
            "type": "string"
          },
          "addedAt": {
            "type": "string",
            "format": "date-time"
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "state",
          "bundleHash",
          "allowedResources",
          "registeredAt",
          "updatedAt"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "TRUSTED",
              "QUARANTINED"
            ]
          },
          "skillPath": {
            "type": "string"
          },
          "bundleHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "allowedResources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url",
                "tier",
                "purpose",
                "maxBytes"
              ],
              "properties": {
                "url": {
                  "type": "string"
                },
                "tier": {
                  "type": "integer",
                  "enum": [0, 1, 2, 3]
                },
                "purpose": {
                  "type": "string"
                },
                "maxBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10485760
                },
                "hash": {
                  "type": "string",
                  "pattern": "^sha256-[a-fA-F0-9]{64}$"
                },
                "schema": {
                  "type": "object"
                },
                "keyId": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "registeredAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "auditedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "auditVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "auditEvidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "quarantineReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "operatorApproval": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
